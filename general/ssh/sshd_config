# Operator SSH for the broker pod: pubkey only, one forced command, no forwarding.
Port 2222
HostKey /var/lib/terracotta-ssh/ssh_host_ed25519_key
PidFile /tmp/sshd.pid
# A static file (ConfigMap) plus the keys the daemon fetches from the operators' GitHub accounts.
AuthorizedKeysFile /etc/terracotta/authorized_keys /var/lib/terracotta/authorized_keys.github
# One unprivileged user in a container nobody else logs in to: ownership checks on the key files
# only break volume mounts (fsGroup makes the directory group-writable, runners own bind mounts).
StrictModes no
AllowUsers tg
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitRootLogin no
UsePAM no
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitUserEnvironment no
PermitTTY yes
ForceCommand /usr/local/bin/terracotta-general ssh-shell
LogLevel INFO
