#!/usr/bin/env python3
"""tini's child: runs sshd and the happier daemon, restarts them, reports health.

sshd is required: if it crash-loops the supervisor exits non-zero so the pod restarts and shows
as failed. The happier daemon is optional (it needs pairing first) and is retried forever.
`ws-supervisor --health` is the probe: exit 0 only if the supervisor reports sshd up and port
2222 accepts connections.
"""

import json
import os
import pathlib
import signal
import base64
import binascii
import hashlib
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

STATUS = pathlib.Path(os.environ.get("WS_STATUS", "/tmp/ws-supervisor.status"))
HOME = pathlib.Path(os.environ.get("HOME", "/home/agent"))
SECRET_KEYS = pathlib.Path("/etc/terracotta-workspace/host-keys")
AUTH_KEYS = pathlib.Path("/etc/terracotta-workspace/authorized_keys")
GITHUB_KEYS = pathlib.Path("/tmp/ws-authorized_keys.github")  # listed in the sshd_config template too
GITHUB_WEB = os.environ.get("WS_GITHUB_WEB", "https://github.com")
KEY_TYPES = ("ssh-ed25519", "sk-ssh-ed25519@openssh.com", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384",
             "ecdsa-sha2-nistp521", "sk-ecdsa-sha2-nistp256@openssh.com", "ssh-rsa")
KEYS_EVERY, KEYS_RETRY = 6 * 3600, 60
SSHD_TEMPLATE = pathlib.Path("/etc/terracotta-workspace/sshd_config")
PORT = 2222
# What git and ws need inside SSH sessions (sshd does not pass the container environment).
# Never an API key.
PASS_TO_SESSIONS = ("PATH", "TG_BROKER", "TG_TOKEN_FILE", "TG_CONTRACT_FILE", "GIT_TERMINAL_PROMPT", "WS_ROOT",
                    "GIT_SSL_CAINFO", "WS_GITHUB_USERS", "WS_GITHUB_WEB", "SSL_CERT_FILE")
CRASH_WINDOW, CRASH_LIMIT = 60.0, 5


def log(msg: str) -> None:
    print(f"ws-supervisor: {msg}", flush=True)


def github_users() -> list[str]:
    return os.environ.get("WS_GITHUB_USERS", "").replace(",", " ").split()


def parse_key(line: str) -> str | None:
    parts = line.split()
    if len(parts) < 2 or parts[0] not in KEY_TYPES or len(line) > 2048:
        return None
    try:
        blob = base64.b64decode(parts[1], validate=True)
    except (binascii.Error, ValueError):
        return None
    return f"{parts[0]} {parts[1]}" if blob.startswith(len(parts[0]).to_bytes(4, "big") + parts[0].encode()) else None


def refresh_github_keys(users: list[str], out: pathlib.Path = GITHUB_KEYS, base: str | None = None) -> list[str]:
    """Write the users' GitHub SSH keys for sshd and return their fingerprints.

    Any failure, or no keys at all, leaves the previous file alone so an outage cannot lock anyone
    out. Redirects are not followed.
    """
    base = base or GITHUB_WEB
    keys: list[str] = []
    for user in users:
        if not user.replace("-", "").isalnum() or user.startswith("-") or len(user) > 39:
            raise ValueError(f"not a GitHub login: {user!r}")

        class NoRedirect(urllib.request.HTTPRedirectHandler):
            def redirect_request(self, *a, **k):  # type: ignore[override]
                return None

        opener = urllib.request.build_opener(NoRedirect)
        with opener.open(f"{base}/{user}.keys", timeout=10) as r:
            text = r.read(1 << 20).decode(errors="replace")
        keys += [k for k in (parse_key(line) for line in text.splitlines()) if k and k not in keys]
    if not keys or len(keys) > 50:
        raise ValueError(f"{len(keys)} usable keys")
    tmp = out.with_suffix(".tmp")
    tmp.write_text("\n".join(keys) + "\n")
    tmp.chmod(0o644)
    os.replace(tmp, out)
    return ["SHA256:" + base64.b64encode(hashlib.sha256(base64.b64decode(k.split()[1])).digest()).decode().rstrip("=")
            for k in keys]


def keep_github_keys_fresh(users: list[str]) -> None:
    while True:
        wait = KEYS_EVERY
        try:
            n = len(refresh_github_keys(users))
            log(f"{n} operator SSH key(s) from GitHub account(s) {', '.join(users)}")
        except (OSError, ValueError, urllib.error.URLError) as e:
            log(f"could not refresh GitHub keys ({e.__class__.__name__}); keeping the previous ones")
            wait = KEYS_RETRY
        time.sleep(wait)


def host_key() -> pathlib.Path:
    """A read-only Secret mounted by the operator wins; otherwise a key on the home volume."""
    if (SECRET_KEYS / "ssh_host_ed25519_key").exists():
        return SECRET_KEYS / "ssh_host_ed25519_key"
    d = HOME / ".ssh-host"
    d.mkdir(mode=0o700, exist_ok=True)
    key = d / "ssh_host_ed25519_key"
    if not key.exists():
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", str(key)], check=True)
        log("generated a new SSH host key on the home volume")
    return key


def render_sshd_config(key: pathlib.Path, out: pathlib.Path = pathlib.Path("/tmp/sshd_config")) -> pathlib.Path:
    env = " ".join(f"{k}={os.environ[k]}" for k in PASS_TO_SESSIONS if k in os.environ)
    out.write_text(SSHD_TEMPLATE.read_text() + f"HostKey {key}\n" + (f"SetEnv {env}\n" if env else ""))
    return out


def link_instructions() -> None:
    """The workspace rules live in the image (the agent cannot edit them) and are linked into the
    volume where Claude Code and OpenCode find them by walking up from a project checkout."""
    src, root = pathlib.Path("/etc/terracotta-workspace/AGENTS.md"), pathlib.Path(os.environ.get("WS_ROOT", "/workspace"))
    for name in ("AGENTS.md", "CLAUDE.md"):
        dst = root / name
        if dst.is_symlink() or not dst.exists():
            dst.unlink(missing_ok=True)
            dst.symlink_to(src)
        else:
            log(f"{dst} exists and is not ours; leaving it")


def happier_paired() -> bool:
    d = HOME / ".happier"
    return d.is_dir() and any(d.iterdir())


class Service:
    def __init__(self, name: str, argv: list[str], required: bool):
        self.name, self.argv, self.required = name, argv, required
        self.proc: subprocess.Popen | None = None
        self.exits: list[float] = []
        self.next_start = 0.0

    def up(self) -> bool:
        return bool(self.proc and self.proc.poll() is None)

    def tick(self, now: float) -> None:
        if self.proc and self.proc.poll() is not None:
            log(f"{self.name} exited with {self.proc.returncode}")
            self.proc = None
            self.exits = [t for t in self.exits if now - t < CRASH_WINDOW] + [now]
            if self.required and len(self.exits) >= CRASH_LIMIT:
                log(f"{self.name} is crash-looping; giving up so the pod restarts")
                raise SystemExit(1)
            self.next_start = now + min(30.0, 2.0 ** len(self.exits))
        if not self.proc and now >= self.next_start:
            self.proc = subprocess.Popen(self.argv)
            log(f"started {self.name} (pid {self.proc.pid})")

    def stop(self) -> None:
        if self.up():
            self.proc.terminate()
            try:
                self.proc.wait(10)
            except subprocess.TimeoutExpired:
                self.proc.kill()


def port_open() -> bool:
    try:
        socket.create_connection(("127.0.0.1", PORT), timeout=2).close()
        return True
    except OSError:
        return False


def health() -> int:
    try:
        st = json.loads(STATUS.read_text())
    except (OSError, ValueError):
        print("no status yet")
        return 1
    if time.time() - st["ts"] > 15 or not st["sshd"] or not port_open():
        print(f"unhealthy: {st}")
        return 1
    print("ok")
    return 0


def main() -> int:
    if "--health" in sys.argv:
        return health()
    users = github_users()
    if "--refresh-keys" in sys.argv:
        if not users:
            print("WS_GITHUB_USERS is not set", file=sys.stderr)
            return 1
        try:
            for fp in refresh_github_keys(users):
                print(fp)
        except (OSError, ValueError, urllib.error.URLError) as e:
            print(f"refresh failed ({e.__class__.__name__}); the previous keys stay in force", file=sys.stderr)
            return 1
        return 0
    if not users and (not AUTH_KEYS.is_file() or not AUTH_KEYS.read_text().strip()):
        log(f"no authorized keys at {AUTH_KEYS} and no WS_GITHUB_USERS: nobody could log in, refusing to start")
        return 1
    if users:
        threading.Thread(target=keep_github_keys_fresh, args=(users,), daemon=True).start()
    link_instructions()
    key = host_key()
    cfg = render_sshd_config(key)
    fp = subprocess.run(["ssh-keygen", "-lf", f"{key}.pub"], capture_output=True, text=True, check=False)
    log("host key " + fp.stdout.strip())
    sshd = Service("sshd", ["/usr/sbin/sshd", "-D", "-e", "-f", str(cfg)], required=True)
    happier = Service("happier", ["happier", "daemon", "start-sync"], required=False)
    services = [sshd]
    stopping: list[int] = []
    signal.signal(signal.SIGTERM, lambda *_: stopping.append(1))
    signal.signal(signal.SIGINT, lambda *_: stopping.append(1))
    try:
        while not stopping:
            now = time.time()
            if happier not in services and happier_paired():
                services.append(happier)
            for s in services:
                s.tick(now)
            STATUS.write_text(json.dumps({"ts": now, "sshd": sshd.up(), "happier": happier.up()}))
            time.sleep(1)
    finally:
        for s in services:
            s.stop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
