#!/usr/bin/env python3
"""git credential helper: asks the broker for a token for each git request.

Holds nothing: no cache, no file. The pod's projected ServiceAccount token proves who is asking.
Denials print the broker's hint (the exact operator command) on stderr, so the agent can relay it.
"""

import json
import os
import sys
import urllib.error
import urllib.request

BROKER = os.environ.get("TG_BROKER", "http://terracotta-general:8080")
TOKEN_FILE = os.environ.get("TG_TOKEN_FILE", "/var/run/secrets/terracotta/token")
CONTRACT_FILE = os.environ.get("TG_CONTRACT_FILE", "/usr/local/share/terracotta/CONTRACT_VERSION")


def say(msg: str) -> None:
    print(f"terracotta: {msg}", file=sys.stderr)


def ask(host: str, path: str, username: str) -> tuple[int, dict]:
    try:
        with open(TOKEN_FILE) as f:
            bearer = f.read().strip()
        with open(CONTRACT_FILE) as f:
            contract = f.read().strip()
    except OSError as e:
        return 0, {"error": f"cannot read {e.filename}"}
    req = urllib.request.Request(
        f"{BROKER}/v1/credential",
        data=json.dumps({"host": host, "path": path, "username": username}).encode(),
        headers={"Authorization": f"Bearer {bearer}", "X-Contract-Version": contract,
                 "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.status, json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.load(e)
        except ValueError:
            return e.code, {}
    except (urllib.error.URLError, OSError) as e:
        return 0, {"error": f"broker unreachable ({e.__class__.__name__})"}


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] != "get":
        return 0  # store/erase: there is nothing of ours to store or forget
    want = dict(line.split("=", 1) for line in sys.stdin.read().splitlines() if "=" in line)
    if want.get("host") != "github.com":
        return 0
    status, body = ask(want["host"], want.get("path", ""), want.get("username", ""))
    if status == 200:
        print(f"username={body['username']}\npassword={body['password']}")
        print(f"password_expiry_utc={body['expires_at']}")
    elif status in (403, 503):
        say(body.get("hint", "denied"))
    elif status == 401:
        say("the broker did not accept this pod's identity")
    elif status == 426:
        say("these workspace tools are older than the broker allows; update the workspace image")
    else:
        say(body.get("error") or body.get("hint") or f"unexpected answer ({status})")
    return 0  # git then asks for nothing more (prompts are off) and fails with the hint above


if __name__ == "__main__":
    sys.exit(main(sys.argv))
