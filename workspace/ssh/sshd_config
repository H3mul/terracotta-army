# Template for /tmp/sshd_config, rendered by ws-supervisor (HostKey and SetEnv lines are appended).
# sshd runs as the unprivileged `agent` user on a high port: no root, no PAM, no sudo.
Port 2222
PidFile /tmp/sshd.pid
# A static file (ConfigMap) plus keys ws-supervisor fetches from GitHub (WS_GITHUB_USERS).
AuthorizedKeysFile /etc/terracotta-workspace/authorized_keys /tmp/ws-authorized_keys.github
# One unprivileged user; ownership checks on mounted key files only break volume mounts.
StrictModes no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
AllowUsers agent
PermitRootLogin no
PermitUserEnvironment no
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding local
PrintMotd no
LogLevel INFO
